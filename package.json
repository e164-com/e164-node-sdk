{
  "name": "e164-node",
  "version": "2.0.1",
  "description": "Zero-dependency Node.js SDK for the e164.com phone number lookup API.",
  "keywords": [
    "e164",
    "phone",
    "phone-number",
    "msisdn",
    "telephony",
    "lookup",
    "carrier",
    "mccmnc",
    "tadig",
    "sdk"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lib/response": {
      "types": "./lib/response.d.ts",
      "default": "./lib/response.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest",
    "test:live": "E164_LIVE=1 jest",
    "typecheck": "tsc --project tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/e164-com/e164-node-sdk.git"
  },
  "author": "E164.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/e164-com/e164-node-sdk/issues"
  },
  "homepage": "https://github.com/e164-com/e164-node-sdk#readme",
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript": "^5.9.3"
  }
}
